+        cu_seqlens_k=cu_seqlens_k,
+        max_seqlen_q=query.shape[0],
+        max_seqlen_k=key.shape[0],
+        softmax_scale=softmax_scale,
+        causal=True,
+        window_size=(-1, -1),
+        out=out.unsqueeze(0),
+    )
