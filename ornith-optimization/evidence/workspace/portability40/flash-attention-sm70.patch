+at::Tensor sm70_d256_splitd_paged_fwd(
+    const at::Tensor &q,
+    const at::Tensor &k,
+    const at::Tensor &v,
+    const at::Tensor &block_table,
+    at::Tensor &out,
+    int64_t kv_len,
+    double softmax_scale,
+    bool causal) {
+    TORCH_CHECK(q.is_cuda() && k.is_cuda() && v.is_cuda()
+                    && block_table.is_cuda() && out.is_cuda(),
+                "q, paged k/v, block_table, and out must be CUDA tensors");
+    TORCH_CHECK(q.scalar_type() == at::ScalarType::Half
+                    && k.scalar_type() == q.scalar_type()
+                    && v.scalar_type() == q.scalar_type()
+                    && out.scalar_type() == q.scalar_type(),
+                "SM70 D256 Split-D paged path requires FP16 q, k, v, and out");
+    TORCH_CHECK(block_table.scalar_type() == at::ScalarType::Int,
+                "block_table must use int32 indices");
+    TORCH_CHECK(q.dim() == 4 && k.dim() == 4 && v.dim() == 4
+                    && block_table.dim() == 2,
+                "paged q/k/v/block_table ranks are invalid");
+    TORCH_CHECK(q.stride(3) == 1 && k.stride(3) == 1 && v.stride(3) == 1
+                    && block_table.stride(1) == 1,
+                "SM70 D256 Split-D paged path requires unit inner strides");
+    TORCH_CHECK(q.stride(0) <= std::numeric_limits<int>::max()
+                    && q.stride(1) <= std::numeric_limits<int>::max()
+                    && q.stride(2) <= std::numeric_limits<int>::max()
+                    && k.stride(0) <= std::numeric_limits<int>::max()
+                    && k.stride(1) <= std::numeric_limits<int>::max()
+                    && k.stride(2) <= std::numeric_limits<int>::max()
+                    && v.stride(0) <= std::numeric_limits<int>::max()
+                    && v.stride(1) <= std::numeric_limits<int>::max()
+                    && v.stride(2) <= std::numeric_limits<int>::max(),
+                "SM70 D256 Split-D paged strides exceed int32 addressing");
+    TORCH_CHECK(k.sizes() == v.sizes()
+                    && q.size(0) == block_table.size(0),
+                "paged k/v and batch/block-table shapes must match");
+    TORCH_CHECK(out.sizes() == q.sizes() && out.is_contiguous(),
+                "SM70 D256 Split-D paged path requires contiguous out matching q");
+    TORCH_CHECK(q.size(3) == 256 && k.size(3) == 256,
+                "SM70 D256 Split-D paged path requires head_dim 256");
+    TORCH_CHECK(q.size(2) % k.size(2) == 0,
+                "query heads must be divisible by KV heads");
+    TORCH_CHECK(q.size(1) <= kv_len
+                    && kv_len <= block_table.size(1) * k.size(1),
+                "paged KV length is outside the block table capacity");
+    TORCH_CHECK(q.size(1) % Sm70D256SplitDTraits::kBlockM == 0
+                    && kv_len % Sm70D256SplitDTraits::kBlockN == 0,
+                "paged exact path requires query and KV lengths divisible by "
+                "their kernel tiles");
+    TORCH_CHECK(k.size(1) % Sm70D256SplitDTraits::kGmemKRowsPerThread == 0,
+                "paged KV page size must preserve vectorized row slices");
+    TORCH_CHECK(causal, "paged exact path requires causal attention");
+    TORCH_CHECK(q.get_device() == k.get_device()
+                    && q.get_device() == v.get_device()
+                    && q.get_device() == out.get_device()
+                    && q.get_device() == block_table.get_device(),
+                "paged inputs must be on one CUDA device");
+
+    const at::cuda::OptionalCUDAGuard device_guard(q.device());
+    const dim3 block(Sm70D256SplitDTraits::kNThreads);
+    const dim3 grid(
+        q.size(1) / Sm70D256SplitDTraits::kBlockM,
+        q.size(0),
+        q.size(2));
+    auto stream = at::cuda::getCurrentCUDAStream();
+    auto kernel =
+        sm70_d256_splitd_dense_kernel<cutlass::half_t, true>;
+    C10_CUDA_CHECK(cudaFuncSetAttribute(
+        kernel,
+        cudaFuncAttributeMaxDynamicSharedMemorySize,
+        Sm70D256SplitDTraits::kSmemBytes));
+    kernel<<<grid, block, Sm70D256SplitDTraits::kSmemBytes, stream>>>(
+        reinterpret_cast<const cutlass::half_t *>(q.data_ptr()),
+        reinterpret_cast<const cutlass::half_t *>(k.data_ptr()),
+        reinterpret_cast<const cutlass::half_t *>(v.data_ptr()),
+        reinterpret_cast<cutlass::half_t *>(out.data_ptr()),
+        static_cast<int>(q.stride(0)),
+        static_cast<int>(q.stride(1)),
+        static_cast<int>(q.stride(2)),
+        static_cast<int>(k.stride(0)),
+        static_cast<int>(k.stride(1)),
+        static_cast<int>(k.stride(2)),
+        static_cast<int>(v.stride(0)),
+        static_cast<int>(v.stride(1)),
+        static_cast<int>(v.stride(2)),
+        q.size(1),
+        static_cast<int>(kv_len),
+        q.size(2),
+        k.size(2),
+        static_cast<float>(softmax_scale * M_LOG2E),
+        block_table.data_ptr<int>(),
+        k.size(1),
+        block_table.stride(0),
+        nullptr,
+        nullptr,
+        nullptr);
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+    return out;
+}
